# Ancestree environment variables
# Copy to .env.local and fill in from your Supabase project settings.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL (used for magic-link redirects and invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (used to email an invite-request approval to the requester — this is
# ancestree's own transactional email, separate from Supabase Auth's SMTP
# config). Reuse the same API key you used as the SMTP password in Supabase.
# Without this set, approving still mints a valid link; the admin just has to
# copy and send it manually instead of it being emailed automatically.
RESEND_API_KEY=
RESEND_FROM_EMAIL="ancestree <no-reply@ancestree.space>"

# Server-only: the secret Vercel Cron sends to /api/cron/newsletter, the
# weekly newsletter (Step 95). Set it in Vercel's env too; without it the
# route refuses every call, so nothing is sent.
CRON_SECRET=

# Native Land Digital (server-only): names the ancestral lands under a place
# of birth or death (Step 27). Free key from https://native-land.ca/auth/signup;
# its Data Sovereignty Treaty allows non-commercial use only and forbids
# storing its data. Without it, no ancestral lands are shown.
NATIVE_LAND_API_KEY=
