{
  "expo": {
    "name": "ancestree",
    "slug": "ancestree",
    "scheme": "ancestree",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "space.ancestree.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ancestree opens your photos only when you pick one for your family tree."
      }
    },
    "android": {
      "package": "app.ancestree.space",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#fbf8f1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      "./plugins/with-scene-life-cycle",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ancestree listens while you tell a family story, and keeps the recording with it.",
          "speechRecognitionPermission": "ancestree turns the story you tell into words for you to read over before it's saved."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ancestree opens the camera only to scan the code that links this phone to your messages.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "78660b88-1630-4056-a8c2-e267173ae152"
      }
    },
    "owner": "aalimr"
  }
}
