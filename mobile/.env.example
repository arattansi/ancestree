# Copy to .env.local. The same public values as the web app's
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SITE_URL.
# Never put the service-role key here: everything in EXPO_PUBLIC_* ships
# inside the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=https://www.ancestree.space
