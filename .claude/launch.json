{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd mobile && PATH=/opt/homebrew/bin:$PATH npx expo start --web --port 8081"],
      "port": 8081
    }
  ]
}
